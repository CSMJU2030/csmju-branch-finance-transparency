# ---------------------------------------------------------------------------
# CSMJU Branch Finance Transparency - example environment
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Backend port (use the 42xx port your team was assigned). The Docker image listens on 4000.
PORT=4210

# This subsystem owns its OWN database. It must NOT point at the Core Hub DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csmju_branch_finance_transparency

# Most connections the pool opens (default 5). On the server every subsystem
# shares one PostgreSQL, so keep it small (standards docs/deployment.md 4.1).
DATABASE_POOL_MAX=5

# Core Hub (identity provider): its API (under /api/v1) and web app share one origin
CORE_HUB_URL=https://csmju2030.jowave.com

# Core Hub public key set (public material only - never the private key)
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json

# Core Hub web app: GET /auth/login sends the browser to <this>/sso/authorize
# and POST /auth/logout to <this>/logout. Same value as the frontend CORE_HUB_WEB_URL.
CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# Immutable Core Hub JWT contract
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# JWKS cache behaviour (milliseconds)
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000

# Core Hub data cache (milliseconds)
CORE_HUB_DATA_CACHE_TTL_MS=600000
CORE_HUB_DATA_MIN_REFRESH_INTERVAL_MS=30000
CORE_HUB_DATA_REQUEST_TIMEOUT_MS=5000

# Subsystem identity - the name in Core Hub Subsystem Registry. It also prefixes the
# cookies: csmju_branch_finance_transparency_access_token / _sso_state
SUBSYSTEM_ID=csmju-branch-finance-transparency
SUBSYSTEM_NAME=CSMJU Branch Finance Transparency

# Clock skew tolerance when validating exp/iat (seconds)
JWT_CLOCK_TOLERANCE_SEC=5

# Only for the one-off cohort seed (pnpm prisma:seed): the current academic year, Buddhist era
# SEED_CURRENT_ACADEMIC_YEAR=2569
